#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
physical="$(readlink -f "$root")"
python3 "$root/scripts/validate_manifest.py" "$physical"
bash -n "$root/demo/run"
python3 -m json.tool "$root/demo/fixtures/example.json" >/dev/null

if command -v node >/dev/null 2>&1 && compgen -G "$root/tests/*.test.js" > /dev/null; then
  node --test "$root/tests"/*.test.js
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$physical"
fi

printf 'All portable plugin checks passed.\n'
